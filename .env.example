# Copy to .env to override defaults.

# Host port for the web vault and WebDAV (container port 8080).
# Change it if 8080 is taken, e.g. on QNAP where QTS uses 8080 by default.
KEEPORT_HTTP_HOST_PORT=8080

# Where KeePort keeps its data. Default: the Docker named volume "keeport-data".
# On a NAS, a folder is easier to back up, e.g. KEEPORT_DATA=./data
# (the folder must be writable by UID/GID 1000).
KEEPORT_DATA=keeport-data

# Host bind for the admin port. Keep 127.0.0.1 and use SSH/VPN, or set a LAN/VPN IP.
# Avoid 0.0.0.0: it opens the admin console on every network of the host (whole subnet,
# VPN/Docker networks, and the internet on hosts with a public IP).
KEEPORT_ADMIN_BIND=127.0.0.1
# Host port of the admin console (the container side is always 8081).
KEEPORT_ADMIN_HOST_PORT=8081

# Set to true only when KeePort is served over HTTPS (true/false; yes/no also work).
KEEPORT_COOKIE_SECURE=false

# Reverse proxies whose X-Forwarded-For header KeePort accepts (loopback is always trusted).
# Find your proxy's address under Admin -> Logs -> WebDAV logs (Client IP) or in the container log.
# Single IPs or CIDR networks, comma-separated, e.g. 172.18.0.1, 192.168.1.10
# List only your proxy, never whole networks: trusted addresses can fake client IPs.
KEEPORT_TRUSTED_PROXIES=
