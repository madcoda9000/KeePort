# Copy to .env to override defaults.

# Bind address for the admin listener inside the container. 8080 serves vault,
# WebDAV and health checks; 8081 is admin-only when KeePort__AdminPorts is set.
KEEPORT_ADMIN_PORT=8081

# Host bind for the admin port. Keep 127.0.0.1 and use SSH/VPN, or set a LAN/VPN IP.
KEEPORT_ADMIN_BIND=127.0.0.1
KEEPORT_ADMIN_HOST_PORT=8081

# Set to true only when KeePort is served over HTTPS.
KEEPORT_COOKIE_SECURE=false
