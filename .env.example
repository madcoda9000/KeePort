# Copy to .env to override defaults.

# Host port for the web vault and WebDAV (container port 8080).
# Change it if 8080 is taken, e.g. on QNAP where QTS uses 8080 by default.
KEEPORT_HTTP_HOST_PORT=8080

# Where KeePort keeps its data. Default: the Docker named volume "keeport-data".
# On a NAS, a folder is easier to back up, e.g. KEEPORT_DATA=./data
# (the folder must be writable by UID/GID 1000).
KEEPORT_DATA=keeport-data

# Host address the admin console listens on. Default 0.0.0.0: every network of the host,
# e.g. your home LAN on a NAS. NEVER forward the admin port on your router.
# On a server with a public IP (VPS), use 127.0.0.1 (SSH tunnel) or a VPN IP instead -
# Docker publishes ports past host firewalls such as ufw.
KEEPORT_ADMIN_BIND=0.0.0.0
# Host port of the admin console (the container side is always 8081).
KEEPORT_ADMIN_HOST_PORT=8081

# The admin console uses HTTPS with a self-signed certificate (created on first start in
# /data/tls). Your browser asks once to accept it. Set to false if a reverse proxy does TLS.
KEEPORT_ADMIN_HTTPS=true
# Optional extra names/IPs for the certificate, comma-separated, e.g. 192.168.1.20, nas.local
KEEPORT_ADMIN_TLS_HOSTS=

# Set to true only when KeePort is served over HTTPS (true/false; yes/no also work).
KEEPORT_COOKIE_SECURE=false

# Reverse proxies whose X-Forwarded-For header KeePort accepts (loopback is always trusted).
# Proxy on the same NAS/server (Synology/QNAP reverse proxy, Caddy/nginx on the host): use
#   KEEPORT_TRUSTED_PROXIES=gateway
# (KeePort trusts its current Docker gateway and follows changes automatically.)
# Proxy elsewhere: its IP or CIDR network, comma-separated, e.g. 192.168.1.10 - see
# Admin -> Logs -> WebDAV logs (Client IP). Never list whole networks: trusted addresses can fake client IPs.
KEEPORT_TRUSTED_PROXIES=

# Website icons: when a user clicks "Save website icon" in the web vault, KeePort fetches the icon from the public
# website (HTTPS only, never from addresses in your network) and the user stores it in the vault. Set to false to
# turn this off, e.g. if the server has no internet access or must not contact other sites.
KEEPORT_FAVICON_DOWNLOAD=true

# Passkeys work on the domain the page is opened with (e.g. https://vault.example.com), never on an IP address.
# Only if your reverse proxy hides that domain from KeePort, set it here, e.g.
#   KEEPORT_PASSKEY_RP_ID=vault.example.com
#   KEEPORT_PASSKEY_ORIGINS=https://vault.example.com
KEEPORT_PASSKEY_RP_ID=
KEEPORT_PASSKEY_ORIGINS=
